# Auto-detect text files and normalize line endings in the repo (LF).
* text=auto

# Scripts and templates must stay LF even on Windows checkout,
# otherwise Git Bash / WSL get "bad interpreter: /usr/bin/env bash^M".
*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.mdc  text eol=lf
*.json text eol=lf

# PowerShell on Windows — native CRLF. File is stored as UTF-8 WITH BOM: without it,
# Windows PowerShell 5.1 reads .ps1 as the ANSI code page and non-ASCII in the script
# can break string-literal parsing. The BOM is part of the content; git keeps it.
*.ps1  text eol=crlf
